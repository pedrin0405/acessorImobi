FROM python:3.12-slim

WORKDIR /app

# Dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini .

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

EXPOSE 8000

# Atualiza o banco antes de subir (uma vez por deploy, só no serviço da API). Se a migração falhar o serviço sobe
# mesmo assim e o erro fica no log, em vez de derrubar o portal.
CMD ["sh", "-c", "alembic upgrade head || echo 'ATENÇÃO: a migração do banco falhou; veja o erro acima'; exec uvicorn app.api.main:app --host 0.0.0.0 --port 8000 --workers 4"]
