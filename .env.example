# =============================================================================
# acessorImobi — Variáveis de Ambiente
# Copie para .env e preencha TODOS os valores antes de subir os containers
# NUNCA commite o arquivo .env
# =============================================================================

# Domínio base (ex: acessorimobi.com.br)
BASE_DOMAIN=acessorimobi.com.br

# Ambiente: development | staging | production
ENVIRONMENT=production
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- MinIO (S3-compatible storage) ---
MINIO_ACCESS_KEY=CHANGE_ME_minio_access
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_at_least_8_chars

# --- Evolution API (WhatsApp gateway) ---
EVOLUTION_API_KEY=CHANGE_ME_evolution_key

# --- Segurança da aplicação ---
# SECRET_KEY: 64 bytes aleatórios em hex — python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_64bytes_hex

# ENCRYPTION_KEY: 32 bytes para AES-256 — python -c "import secrets; print(secrets.token_hex(32))"
# Usado para cifrar credenciais Imoview por tenant em repouso
ENCRYPTION_KEY=CHANGE_ME_32bytes_hex

# --- Ollama (LLM local) ---
# Número de requisições paralelas ao modelo
OLLAMA_NUM_PARALLEL=4

# --- Whisper (transcrição de áudio) ---
# Modelos disponíveis: tiny, base, small, medium, large
WHISPER_MODEL=medium

# --- Worker ---
WORKER_CONCURRENCY=8
WORKER_MAX_PER_TENANT=3
