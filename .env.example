# =============================================================================
# acessorImobi — Variáveis de Ambiente
# =============================================================================

# Geral
ENVIRONMENT=development
LOG_LEVEL=info
BASE_DOMAIN=acessorimobi.local

# Banco de Dados (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://acessor:acessor_secret_pass@localhost:5432/acessorimobi
POSTGRES_PASSWORD=acessor_secret_pass

# Redis (Fila, Locks e Cache)
REDIS_URL=redis://:redis_secret_pass@localhost:6379/0
REDIS_PASSWORD=redis_secret_pass

# MinIO (Storage S3-compatível para áudios)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_AUDIOS=audios
MINIO_SECURE=false

# Provedor de IA: gemini (nuvem) ou ollama (local)
LLM_PROVIDER=gemini

# Gemini (chat + TTS)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
# Resposta em áudio: mirror (áudio recebido e, de vez em quando, texto), always ou never
VOICE_REPLY_MODE=mirror
# Em mirror, chance de responder em áudio (no lugar do texto) a mensagens de
# texto (0 a 1). Nunca dois áudios seguidos; dados como links/telefones vão por escrito.
VOICE_REPLY_AUDIO_CHANCE=0.2
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Usado automaticamente se o modelo principal estourar a cota diária.
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_MAX_CHARS=1800
# Limites exibidos no painel do dev (0 = sem limite). Use os valores do seu
# plano em https://aistudio.google.com/rate-limit. Um 429 do Gemini marca o
# limite como atingido e pausa as chamadas pelo retryDelay informado.
GEMINI_CHAT_DAILY_LIMIT=200
GEMINI_TTS_DAILY_LIMIT=10
GEMINI_CHAT_RPM_LIMIT=15
GEMINI_TTS_RPM_LIMIT=3
# A partir deste percentual o painel mostra "perto do limite".
USAGE_ALERT_PERCENT=80
USAGE_TIMEZONE=America/Sao_Paulo

# TTS local Qwen3 (open source, ilimitado). Requer o servidor rodando no host:
#   ~/.venvs/qwen3-tts/bin/python scripts/qwen3_tts_server.py
# auto = tenta Qwen3 primeiro e usa Gemini como fallback; qwen3 ou gemini fixam o provedor.
TTS_PROVIDER=auto
QWEN3_TTS_URL=http://host.docker.internal:8010
QWEN3_TTS_SPEAKER=Serena
QWEN3_TTS_LANGUAGE=Portuguese
QWEN3_TTS_TIMEOUT_SECONDS=300
# Falas curtas: geração local fica ~5x o tempo real no M4.
QWEN3_TTS_MAX_CHARS=500
# Opcional: exige Authorization: Bearer <token> no servidor local.
# QWEN3_TTS_TOKEN=

# Ollama (LLM e embeddings locais)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3:8b
OLLAMA_NUM_PARALLEL=4
OLLAMA_TIMEOUT_SECONDS=240

# Whisper (Transcrição de áudio local)
WHISPER_BASE_URL=http://localhost:9000
WHISPER_MODEL=medium
WHISPER_ENGINE=faster_whisper
WHISPER_QUANTIZATION=int8
WHISPER_IDLE_TIMEOUT=600
WHISPER_TIMEOUT_SECONDS=180
WHISPER_MAX_AUDIO_SECONDS=180

# Evolution API (WhatsApp Gateway v2)
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution_global_api_key_123
# ERROR em operação normal; INFO/DEBUG para diagnosticar envio de webhooks
EVOLUTION_LOG_LEVEL=ERROR

# Segurança e Criptografia
DEV_PANEL_PASSWORD=admin123
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
# Chave AES de 32 bytes hex para credenciais do Imoview (64 caracteres hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Worker
WORKER_CONCURRENCY=8
WORKER_MAX_PER_TENANT=3
CONTEXT_WINDOW_MESSAGES=12
CONTEXT_WINDOW_TOKENS=2500

# Cache TTLs (segundos)
CACHE_IMOVEL_TTL=1800
CACHE_CLIENTE_TTL=900
CACHE_TAXAS_TTL=3600
CACHE_NOTICIAS_TTL=900

# Imoview CRM
IMOVIEW_MAX_RESULTS=5
IMOVIEW_SYNC_INTERVAL_MINUTES=30

# Traefik / TLS (Let's Encrypt)
ACME_EMAIL=devops@acessorimobi.com.br

# LGPD
RETENCAO_MENSAGENS_DIAS=180
RETENCAO_AUDITORIA_DIAS=365
